<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="quadruped">

  <xacro:include filename="xacro_macros.urdf.xacro" />

  <link name="world"></link>

  <joint name="base_joint" type="fixed">
    <parent link="world" />
    <child link="robot_base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
  </joint>

  <link name="robot_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find quadruped_description)/meshes/robot_base.stl" />
      </geometry>
      <material name="green">
        <color rgba="0.2 1 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="2.5 1.5 0.1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="12" />
      <origin xyz="0 0 0" />
      <inertia ixx="2.26" ixy="0.0" ixz="0.0" iyy="6.26" iyz="0.0" izz="8.5" />
    </inertial>
  </link>

  <joint name="body_link1_joint" type="revolute">
    <parent link="robot_base_link" />
    <child link="leg_link_1" />
    <origin xyz="-58.77 58.981 12.432" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="${-pi/4}" upper="${pi/4}" effort="10000" velocity="10000" />
  </joint>

  <link name="leg_link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find quadruped_description)/meshes/link1.stl" />
      </geometry>
      <material name="cyan">
        <color rgba="0 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="1 2 1" />
      </geometry>
    </collision>qq
    <inertial>
      <mass value="4" />
      <origin xyz="0 0 0" />
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
    </inertial>
  </link>
</robot>